# Demo values for a local lab. Do not reuse them anywhere else.
RABBITMQ_PASSWORD=broka-lab-pass

RABBITMQ_MANAGEMENT_PORT=15710
RABBITMQ_AMQP_PORT=15711

# Messages per second into orders.audit, and out of it.
PUBLISH_RATE=30
CONSUME_RATE=5
# Unacknowledged messages the consumer may hold at once.
CONSUMER_PREFETCH=20
