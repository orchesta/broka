{
  "vhosts": [
    { "name": "shop", "description": "Routing lab", "tags": [], "default_queue_type": "classic" }
  ],
  "permissions": [
    { "user": "broka", "vhost": "shop", "configure": ".*", "write": ".*", "read": ".*" }
  ],
  "exchanges": [
    {
      "name": "orders", "vhost": "shop", "type": "topic",
      "durable": true, "auto_delete": false, "internal": false,
      "arguments": { "alternate-exchange": "orders.unrouted" }
    },
    {
      "name": "orders.unrouted", "vhost": "shop", "type": "fanout",
      "durable": true, "auto_delete": false, "internal": false, "arguments": {}
    },
    {
      "name": "orders.audit.fanout", "vhost": "shop", "type": "fanout",
      "durable": true, "auto_delete": false, "internal": true, "arguments": {}
    },
    {
      "name": "orders.dlx", "vhost": "shop", "type": "topic",
      "durable": true, "auto_delete": false, "internal": false, "arguments": {}
    },
    {
      "name": "invoices", "vhost": "shop", "type": "direct",
      "durable": true, "auto_delete": false, "internal": false,
      "arguments": { "alternate-exchange": "invoices.unrouted" }
    },
    {
      "name": "shipments", "vhost": "shop", "type": "headers",
      "durable": true, "auto_delete": false, "internal": false, "arguments": {}
    }
  ],
  "queues": [
    {
      "name": "orders.processing", "vhost": "shop", "durable": true, "auto_delete": false,
      "arguments": { "x-queue-type": "classic", "x-max-length": 20, "x-dead-letter-exchange": "orders.dlx" }
    },
    {
      "name": "orders.audit", "vhost": "shop", "durable": true, "auto_delete": false,
      "arguments": { "x-queue-type": "classic" }
    },
    {
      "name": "orders.audit.archive", "vhost": "shop", "durable": true, "auto_delete": false,
      "arguments": { "x-queue-type": "classic" }
    },
    {
      "name": "orders.unrouted", "vhost": "shop", "durable": true, "auto_delete": false,
      "arguments": { "x-queue-type": "classic" }
    },
    {
      "name": "orders.dlq", "vhost": "shop", "durable": true, "auto_delete": false,
      "arguments": { "x-queue-type": "classic" }
    },
    {
      "name": "shipments.express", "vhost": "shop", "durable": true, "auto_delete": false,
      "arguments": { "x-queue-type": "classic", "x-max-length": 5, "x-overflow": "reject-publish" }
    }
  ],
  "bindings": [
    {
      "source": "orders", "vhost": "shop", "destination": "orders.processing",
      "destination_type": "queue", "routing_key": "order.created", "arguments": {}
    },
    {
      "source": "orders", "vhost": "shop", "destination": "orders.audit",
      "destination_type": "queue", "routing_key": "order.#", "arguments": {}
    },
    {
      "source": "orders", "vhost": "shop", "destination": "orders.audit.fanout",
      "destination_type": "exchange", "routing_key": "order.#", "arguments": {}
    },
    {
      "source": "orders.audit.fanout", "vhost": "shop", "destination": "orders.audit.archive",
      "destination_type": "queue", "routing_key": "", "arguments": {}
    },
    {
      "source": "orders.unrouted", "vhost": "shop", "destination": "orders.unrouted",
      "destination_type": "queue", "routing_key": "", "arguments": {}
    },
    {
      "source": "orders.dlx", "vhost": "shop", "destination": "orders.dlq",
      "destination_type": "queue", "routing_key": "#", "arguments": {}
    },
    {
      "source": "shipments", "vhost": "shop", "destination": "shipments.express",
      "destination_type": "queue", "routing_key": "",
      "arguments": { "x-match": "all", "region": "eu", "priority": 3 }
    }
  ]
}
