# Host ports of the three brokers' listeners that BROKA connects to.
KAFKA_1_PORT=19121
KAFKA_2_PORT=19122
KAFKA_3_PORT=19123

# Address the brokers hand back to clients outside this lab. Keep host.docker.internal on Docker Desktop;
# on Linux set it to the host's IP address.
KAFKA_ADVERTISED_HOST=host.docker.internal

# Host port of the Schema Registry's REST API.
SCHEMA_REGISTRY_PORT=18086

# Page views per second written to clickstream.raw.
RATE=40
