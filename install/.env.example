# Copy to .env and fill in the four secrets once, at install time.
# Back this file up with the database: the secrets cannot be recovered.
#
#   POSTGRES_PASSWORD    openssl rand -base64 24
#   BROKA_JWT_SECRET     openssl rand -base64 48
#   BROKA_KEK            openssl rand -base64 32    (must decode to exactly 32 bytes)
#   BROKA_SERVICE_TOKEN  openssl rand -hex 32

POSTGRES_PASSWORD=
BROKA_DB_SSL_MODE=prefer

BROKA_JWT_SECRET=
BROKA_JWT_KEY_ID=jwt-1
# Set only while rotating the signing key.
BROKA_JWT_PREVIOUS_ID=
BROKA_JWT_PREVIOUS=

BROKA_KEK=
BROKA_KEK_ID=kek-1
# Set only while rotating the key-encryption key.
BROKA_KEK_PREVIOUS_ID=
BROKA_KEK_PREVIOUS=

BROKA_SERVICE_TOKEN=

# Pin the version; upgrades apply database migrations and are not reversible by downgrading.
BROKA_VERSION=1.0.0
BROKER_IMAGE=orchestalabs/broka-broker
ORCHESTRATOR_IMAGE=orchestalabs/broka-orchestrator
UI_IMAGE=orchestalabs/broka-ui

BROKA_LICENCE_SERVER=https://license.broka.dev
BROKA_HTTP_PORT=3000
# Networks allowed to set X-Forwarded-* headers (your reverse proxy).
BROKA_TRUSTED_PROXIES=172.16.0.0/12
# Public address of the console, used for links in alert notifications.
BROKA_PUBLIC_URL=
BROKA_KEYSTORE_DIR=/etc/broka/keystores
BROKA_METRICS_PROMETHEUS=false
