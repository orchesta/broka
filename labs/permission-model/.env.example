# Demo values for a local lab. Do not reuse them anywhere else.

# Kafka: the listener BROKA connects to, and the address the broker hands back to clients outside this lab.
# Keep host.docker.internal on Docker Desktop; on Linux set it to the host's IP address.
KAFKA_PORT=19100
KAFKA_ADVERTISED_HOST=host.docker.internal

# Kafka principals: admin is the super-user BROKA connects as; the other two are applications.
KAFKA_ADMIN_PASSWORD=admin-lab-pass
KAFKA_CHECKOUT_PASSWORD=checkout-lab-pass
KAFKA_READER_PASSWORD=reader-lab-pass

# RabbitMQ: broka is the administrator BROKA connects as; the other three are applications.
RABBITMQ_MANAGEMENT_PORT=15720
RABBITMQ_AMQP_PORT=15721
RABBITMQ_PASSWORD=broka-lab-pass
RABBITMQ_PAYMENTS_PASSWORD=payments-lab-pass
RABBITMQ_ORDERS_PASSWORD=orders-lab-pass
RABBITMQ_DENIED_PASSWORD=denied-lab-pass
