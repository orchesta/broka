# Host port of the HOST listener, for the programs you run on this machine. If you change it, change
# localhost:19232 in the Java and Python code too.
KAFKA_HOST_PORT=19232

# Host port of the EXTERNAL listener, for clients in other containers, such as BROKA.
KAFKA_PORT=19132

# Address the broker hands back to clients on the EXTERNAL listener. Keep host.docker.internal on Docker
# Desktop; on Linux set it to the host's IP address.
KAFKA_ADVERTISED_HOST=host.docker.internal
